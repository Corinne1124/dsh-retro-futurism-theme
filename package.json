{
  "name": "dsh-retro-futurism",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Retro-futurism theme for DeepSeek Harness: neon alias-token palettes, CRT overlay and a terminal type stack",
  "main": "./dist/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "gen:tokens": "node scripts/gen-verified-tokens.mjs",
    "pretest": "npm run build",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
